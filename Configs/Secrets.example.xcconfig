// Secrets.example.xcconfig
// MovieDB
//
// Copy this file to Configs/Secrets.xcconfig and paste your TMDB "API Read Access Token" (the long v4 token).
// You can find it at https://www.themoviedb.org/settings/api
// Secrets.xcconfig is in .gitignore, so it stays on your machine.
//
// Do not wrap the value in quotes.

TMDB_ACCESS_TOKEN =
